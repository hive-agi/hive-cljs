{:deps true
 :nrepl {:port 7889}
 :dev-http {8280 "public"}
 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "/js"
                :modules {:main {:init-fn demo.app/init}}}

          ;; Not watched. Exists so `cljs compile ci` has a build to drive
          ;; through one cycle on demand.
          :ci  {:target :browser
                :output-dir "target/ci-js"
                :asset-path "/ci-js"
                :modules {:main {:init-fn demo.app/init}}}}}

{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure           {:mvn/version "1.12.5"}

  ;; hive-addon — IAddon protocol + CLI subcommand dispatcher (host bridge)
  io.github.hive-agi/hive-addon {:mvn/version "1.0.0"}

  ;; hive-dsl — Result monad, ADTs, error taxonomy
  io.github.hive-agi/hive-dsl   {:mvn/version "0.5.21"}

  ;; hive-di — defconfig: typed env/literal sources, Result-returning resolution
  io.github.hive-agi/hive-di    {:mvn/version "0.4.8"}

  ;; hive-schemas — malli value objects + schema-synthesized test facets
  io.github.hive-agi/hive-schemas {:mvn/version "0.1.29"}

  ;; hive-weave — bounded execution primitives for the watch supervisor
  io.github.hive-agi/hive-weave {:mvn/version "0.3.6"}

  ;; hive-events — event bus for build → e2e coupling
  io.github.hive-agi/hive-events {:mvn/version "0.5.10"}

  metosin/malli                 {:mvn/version "0.20.1"}

  ;; shadow-cljs remote-relay transport (websocket + transit)
  com.cognitect/transit-clj     {:mvn/version "1.1.363"}
  stylefruits/gniazdo           {:mvn/version "1.2.2"}
  clj-http/clj-http             {:mvn/version "3.13.1"}

  ;; cljs-eval channel
  nrepl/nrepl                   {:mvn/version "1.7.0"}

  com.taoensso/timbre           {:mvn/version "6.8.0"}

  ;; Browser adapter. A base dep, not an alias: an IAddon must be
  ;; batteries-included, because tools.deps aliases do NOT propagate to a host
  ;; that mounts this lib — the host would otherwise have to declare our vendor.
  ;; ~195M in ~/.m2 (driver-bundle ships node + the driver); nothing is
  ;; extracted or launched until a scenario opens a session.
  com.microsoft.playwright/playwright {:mvn/version "1.62.0"}
  org.clojure/data.json {:mvn/version "2.5.2"}}

 :aliases
 {;; Retained so `-M:browser` keeps working for anyone who scripted it.
  ;; The coord now lives in :deps; this adds nothing.
  :browser {}

  :test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha          {:mvn/version "1.91.1392"}
                io.github.hive-agi/hive-test {:mvn/version "0.4.0"}
                org.clojure/test.check       {:mvn/version "1.1.3"}}
   :main-opts ["-m" "kaocha.runner"]}

  :nrepl
  {:extra-paths ["test" "dev"]
   :extra-deps {nrepl/nrepl       {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.62.2"}}
   :main-opts ["-m" "nrepl.cmdline"
               "--middleware" "[cider.nrepl/cider-middleware]"
               "--port" "7941"]}

  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.11"}}
   :ns-default hive-build.api}}}

{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure           {:mvn/version "1.12.1"}

  ;; hive-addon — IAddon protocol + CLI subcommand dispatcher (host bridge)
  io.github.hive-agi/hive-addon {:mvn/version "0.3.4"}

  ;; hive-dsl — Result monad, ADTs, error taxonomy
  io.github.hive-agi/hive-dsl   {:mvn/version "0.5.9"}

  ;; hive-di — defconfig: typed env/literal sources, Result-returning resolution
  io.github.hive-agi/hive-di    {:mvn/version "0.3.2"}

  ;; hive-schemas — malli value objects + schema-synthesized test facets
  io.github.hive-agi/hive-schemas {:mvn/version "0.1.11"}

  ;; hive-weave — bounded execution primitives for the watch supervisor
  io.github.hive-agi/hive-weave {:mvn/version "0.3.1"}

  ;; hive-events — event bus for build → e2e coupling
  io.github.hive-agi/hive-events {:mvn/version "0.5.6"}

  metosin/malli                 {:mvn/version "0.19.1"}

  ;; shadow-cljs remote-relay transport (websocket + transit)
  com.cognitect/transit-clj     {:mvn/version "1.0.333"}
  stylefruits/gniazdo           {:mvn/version "1.2.2"}
  clj-http/clj-http             {:mvn/version "3.13.1"}

  ;; cljs-eval channel
  nrepl/nrepl                   {:mvn/version "1.7.0"}

  com.taoensso/timbre           {:mvn/version "6.8.0"}}

 :aliases
 {;; Browser adapter deps are OPTIONAL — the lib loads and the pure spine tests
  ;; run with zero vendors present.
  :browser
  {:extra-deps {com.microsoft.playwright/playwright {:mvn/version "1.55.0"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha          {:mvn/version "1.91.1392"}
                io.github.hive-agi/hive-test {:mvn/version "0.3.10"}
                org.clojure/test.check       {:mvn/version "1.1.1"}}}

  :nrepl
  {:extra-paths ["test" "dev"]
   :extra-deps {nrepl/nrepl       {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.58.0"}}
   :main-opts ["-m" "nrepl.cmdline"
               "--middleware" "[cider.nrepl/cider-middleware]"
               "--port" "7941"]}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
          slipset/deps-deploy           {:mvn/version "0.2.2"}}
   :ns-default build}}}
